# Copy to .env and set real values before running

# Path to SQLite database file
# For Railway: file:/data/prod.db  (points to the mounted volume)
# For local dev: file:./dev.db
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs — must be a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-before-deploying"
