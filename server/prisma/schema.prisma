datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Card {
  id          String    @id @default(cuid())
  areaId      String
  column      String
  title       String
  urgency     String    @default("medium")
  dueDate     String?
  notes       String?
  progress    Int?
  totalUnits  Int?
  currentUnit Int?
  itemType    String?
  completedAt DateTime?
  source      String?
  sourceUrl   String?
  externalId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Auth {
  id           String @id @default("singleton")
  passwordHash String
}

model SyncAccount {
  id           String    @id @default(cuid())
  displayName  String
  email        String
  tenantId     String
  msAccountId  String    @unique
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  scopes       String
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
}

model SyncRule {
  id        String   @id @default(cuid())
  name      String
  source    String
  fromEmail String?
  keyword   String?
  accountId String?
  areaId    String
  column    String
  urgency   String   @default("medium")
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}
